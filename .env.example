# JAgent 环境变量样例：复制为 .env 并按需填写。
# 服务启动时按 CWD/.env → 仓库根/.env 顺序读取（不装 python-dotenv）；
# 缺 LLM 配置时服务能起，但降级为模板模式（诚实地拒绝复杂任务）。
# 本文件是清单不是默认值——所有变量都有代码内默认值，见各条注释。

# --------------------------------------------------------------- LLM 接入 --
# OpenAI 兼容协议。JAGENT_LLM_* 优先，LLM_* 是兼容别名（两套任选其一）。
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL_NAME=
# 以下可选（秒/最大 token/是否关闭思考模式，视模型而定）
# LLM_TIMEOUT_S=180
# LLM_MAX_TOKENS=
# LLM_DISABLE_THINKING=false

# ------------------------------------------------------------ 服务与数据 --
# 服务绑定地址（默认 127.0.0.1；Linux 服务器部署对外暴露时改 0.0.0.0，
# 并自行加上反代/防火墙——本服务无鉴权，不要裸奔在公网）
# JAGENT_HOST=127.0.0.1
# 服务端口（默认 8021）
# JAGENT_PORT=8021
# 数据根：events.db / artifacts / workspace / memory 都在这下面
# （默认 data/v8_http，相对启动时的工作目录）
# JAGENT_DATA_DIR=data/v8_http

# ------------------------------------------------------------- MCP 工具 --
# JAGENT_MCP_ENABLED=true
# JAGENT_MCP_META_URL=
# JAGENT_MCP_A_SHARE_URL=
# MCP 服务鉴权 key，按 JAGENT_MCP_API_KEY → FUYAO_API_KEY → THS_API_KEY →
# AICUBES_API_KEY 顺序探测；一个都没有时 MCP 整体静默关闭
# JAGENT_MCP_API_KEY=

# -------------------------------------------------- 真实模型在线 e2e（opt-in）
# 仅 `pytest -m llm tests/e2e_live -s` 使用，全部有默认值，一般不用设
# JAGENT_E2E_ONLY=
# JAGENT_E2E_FILE=
# JAGENT_E2E_WRITE_TARGET=
# JAGENT_E2E_MARKER=
# JAGENT_E2E_TICKER=
# JAGENT_E2E_COMPANY=

# ------------------------------------------------------------- 预留未接线 --
# Langfuse 导出（S3，D-031 后置项）：已规划未接线，填了也不生效
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
